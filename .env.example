# Copy to .streamlit/secrets.toml for local dashboard runs (Streamlit's own
# secrets mechanism), or set as repository secrets in GitHub Actions / your
# Streamlit Cloud app settings. Nothing in this file is a real credential.

# Gates every watchlist WRITE (add/remove). Leave unset locally and the
# watchlist tab stays fully read-only -- has_write_access() fails closed.
WATCHLIST_SECRET=

# Needed only if you want the watchlist to actually persist to GitHub
# (GitHubWatchlistStore). Needs `contents: write` on GITHUB_REPO.
GITHUB_TOKEN=
GITHUB_REPO=your-username/stockgpt-enhanced
GITHUB_BRANCH=main
