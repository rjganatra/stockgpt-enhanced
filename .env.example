# Copy to .streamlit/secrets.toml for local dashboard runs (Streamlit's own
# secrets mechanism), or set as repository secrets in GitHub Actions / your
# Streamlit Cloud app settings. Nothing in this file is a real credential.

# Gates every watchlist WRITE (add/remove). Leave unset locally and the
# watchlist tab stays fully read-only -- has_write_access() fails closed.
WATCHLIST_SECRET=

# Needed only if you want the watchlist to actually persist to GitHub
# (GitHubWatchlistStore). Needs `contents: write` on GITHUB_REPO.
GITHUB_TOKEN=
GITHUB_REPO=your-username/stockgpt-enhanced
GITHUB_BRANCH=main

# Alerts (scripts/run_alerts.py, run automatically as a step in
# daily_pipeline.yml): set these as GitHub Actions repository secrets, not
# here -- this file is only ever a local reference of what exists, never a
# place to actually put real credentials. Both channels are optional and
# independent; set either, both, or neither (neither means alerts are still
# computed and printed in the workflow log, just not delivered anywhere).

# Telegram: message @BotFather to create a bot and get TELEGRAM_BOT_TOKEN,
# then message your new bot once and hit
# https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email: e.g. an app-specific password for Gmail (smtp.gmail.com, port 587)
# -- not your regular account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
